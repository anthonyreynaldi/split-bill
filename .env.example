# ─────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.
# None of these use the NEXT_PUBLIC_ prefix, so they all stay on the server.
# ─────────────────────────────────────────────────────────────────────

# Which repository implementation container.ts wires in:
#   supabase → real database (default)
#   memory   → no database, data is lost on restart (quick demo / UI work)
DATA_BACKEND=supabase

# Supabase → Project Settings → API (or Data API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" key or a new "secret" key (sb_secret_...). SECRET: bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, ONLY for `npm run db:migrate` (the app doesn't use it).
# Dashboard → Connect → "Session pooler" URI, with your DB password. SECRET.
# The "Direct connection" host is IPv6-only and often fails locally.
# CI uses the same value from the GitHub secret SUPABASE_DB_URL.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Signs the login session and share-link cookies. At least 32 random chars:
#   openssl rand -base64 32
# Changing it logs everybody out.
SESSION_SECRET=

# OCR (receipt reading). Leave empty to disable OCR (manual entry still works).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Vision-capable model id, or a comma-separated PRIORITY LIST of them.
# Free models (":free") share a quota with every OpenRouter user and are often
# rate-limited, so list several: the next one is used when one is busy.
# Keep only ":free" ids so it never costs anything. Current free vision models:
#   https://openrouter.ai/models?input_modalities=image&max_price=0
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free

# Public base URL, used to build share links.
APP_URL=http://localhost:3000

# Optional: run the repository contract tests against a THROWAWAY Supabase project.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
